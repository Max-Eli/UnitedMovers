# Resend email delivery for the contact / quote form.
# Copy this file to .env.local and fill in real values.

# 1. Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 2. The "from" address. The domain must be verified in Resend
#    (https://resend.com/domains). Use a sender on your own domain.
#    Example: "United Movers <quotes@unitedmoversfl.com>"
RESEND_FROM="United Movers <quotes@unitedmoversfl.com>"

# 3. Where leads are delivered. Defaults to the business inbox if left unset.
LEAD_TO=unitedmovingfl@gmail.com
